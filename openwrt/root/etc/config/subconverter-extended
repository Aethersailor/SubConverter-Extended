config service 'service'
	option config_version '1'
	option config_file '/etc/subconverter/pref.toml'
	option listen_address ''
	option listen_port ''
	option security_profile ''
	option allow_public_upload ''
	option resource_control ''
	option log_level ''
	option statistics_enabled ''

config update 'update'
	option enabled '1'
	option auto_check '1'
	option auto_install '0'
	option check_interval '86400'
	option install_start '03:00'
	option install_end '05:00'
	option proxy_mode 'auto'
