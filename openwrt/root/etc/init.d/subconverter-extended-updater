#!/bin/sh /etc/rc.common

USE_PROCD=1
START=98
STOP=11

UPDATER=/usr/libexec/subconverter-extended-update

start_service() {
	local enabled

	config_load 'subconverter-extended'
	[ -x "$UPDATER" ] || return 1
	if [ -s /etc/subconverter/update/pending.json ]; then
		"$UPDATER" recover
		recovery_result=$?
		case "$recovery_result" in
			0) ;;
			10)
				exec /etc/init.d/subconverter-extended-updater start
				;;
			*)
				logger -t subconverter-extended-update \
					'Update recovery failed; refusing to start the updater daemon'
				return 1
				;;
		esac
	fi
	config_get_bool enabled update enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance 'daemon'
	procd_set_param command "$UPDATER" daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 30
	procd_close_instance
	rm -f /tmp/subconverter-extended/deferred-updater-reload
}

reload_service() {
	if [ "${SUBCONVERTER_UPDATE_TRANSACTION:-0}" != '1' ] && \
	   [ -s /etc/subconverter/update/pending.json ]; then
		logger -t subconverter-extended-update \
			'Deferring updater reload while an update transaction is active'
		touch /tmp/subconverter-extended/deferred-updater-reload
		return 0
	fi
	stop
	wait_count=0
	while /etc/init.d/subconverter-extended-updater running >/dev/null 2>&1; do
		wait_count=$((wait_count + 1))
		[ "$wait_count" -lt 40 ] || return 1
		sleep 1
	done
	start || return 1
	rm -f /tmp/subconverter-extended/deferred-updater-reload
}

service_triggers() {
	procd_add_reload_trigger 'subconverter-extended'
}
