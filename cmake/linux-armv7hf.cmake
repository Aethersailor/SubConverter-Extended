set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(ARM_TRIPLET arm-linux-gnueabihf CACHE STRING "ARM cross-compiler triplet")
set(ARM_CPU_FLAGS "-march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard" CACHE STRING "ARM CPU and floating-point ABI flags")

set(CMAKE_C_COMPILER ${ARM_TRIPLET}-gcc)
set(CMAKE_CXX_COMPILER ${ARM_TRIPLET}-g++)
set(CMAKE_AR ${ARM_TRIPLET}-ar)
set(CMAKE_RANLIB ${ARM_TRIPLET}-ranlib)
set(CMAKE_STRIP ${ARM_TRIPLET}-strip)

set(CMAKE_LIBRARY_ARCHITECTURE ${ARM_TRIPLET})
set(CMAKE_C_FLAGS_INIT "${ARM_CPU_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${ARM_CPU_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,-rpath-link,/lib/${ARM_TRIPLET} -Wl,-rpath-link,/usr/lib/${ARM_TRIPLET} -Wl,-rpath-link,/usr/${ARM_TRIPLET}/lib")
set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "-latomic")

set(CMAKE_FIND_ROOT_PATH /opt/armv7 /usr/${ARM_TRIPLET})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
